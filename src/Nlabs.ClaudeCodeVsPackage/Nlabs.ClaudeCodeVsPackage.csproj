<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK tarzı VSSDK eklenti projesi.

    Hedef net472 bir tercih değil: Visual Studio'nun kabuğu (devenv.exe) hâlâ .NET
    Framework 4.7.2 üzerinde koşar. Süreç içi (in-proc) yüklenen her eklenti bu
    runtime'da olmak zorundadır; .NET 10/11 bunu değiştirmez. Kısıt runtime API
    yüzeyindedir, dilde değil: LangVersion latest ile güncel C# sözdizimi serbesttir.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Nlabs.ClaudeCodeVsPackage</RootNamespace>
    <AssemblyName>Nlabs.ClaudeCodeVsPackage</AssemblyName>

    <!-- Yayın sürümü manifest'ten takip edilir; AssemblyVersion SABİT kalır. -->
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!-- VSIX kapsayıcısı: pkgdef üret, çıktı assembly'yi pakete koy, sembolleri koyma. -->
  <PropertyGroup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>true</IncludeCopyLocalReferencesInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <UseCodebase>true</UseCodebase>
  </PropertyGroup>

  <!-- VSIX manifest'i: SDK globlaması onu zaten None olarak alır; burada yalnız
       Designer alt tipini veriyoruz (Include değil Update - çift kayıt olmasın). -->
  <ItemGroup>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
