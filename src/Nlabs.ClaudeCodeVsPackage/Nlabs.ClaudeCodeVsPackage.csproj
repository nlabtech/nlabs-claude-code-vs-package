<Project Sdk="Microsoft.NET.Sdk">

  <!--
    SDK-style VSSDK extension project.

    Targeting net472 is not a preference: the Visual Studio shell (devenv.exe) still
    runs on .NET Framework 4.7.2. Any in-process extension must live in that runtime;
    .NET 10/11 does not change this. The constraint is on the runtime API surface, not
    the language: LangVersion latest keeps modern C# syntax available.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- The agentic panel is a WPF tool window built in code (no XAML). WPF types come from the
         framework, so nothing new is bundled into the VSIX - a Visual Studio tool window is WPF
         already. This only turns on the WPF reference set for this project. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>Nlabs.ClaudeCodeVsPackage</RootNamespace>
    <AssemblyName>Nlabs.ClaudeCodeVsPackage</AssemblyName>

    <!--
      Version identity, deliberately split:

      AssemblyVersion is FIXED at 1.0.0.0 and must NOT change between releases. Visual
      Studio's MEF component cache and assembly binding key on the strong name (which
      includes AssemblyVersion). Bump it every build and VS keeps rebuilding the MEF
      cache and old binding redirects break - the extension "randomly" stops loading.

      Version/FileVersion DO move with each release (this is what the manifest and the
      file properties show), so you still get a real, human-meaningful version number.
    -->
    <Version>0.4.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>

  <!-- VSIX container: generate pkgdef, put the output assembly in the package, no symbols.
       VSSDKBuildToolsAutoSetup MUST be true: without it the build tools default it to
       false, the VSSDK targets are never imported, and the project compiles to a DLL but
       produces NO .vsix (the CreateVsixContainer target does not even exist). This one
       line is what turns a plain net472 class library into a real VSIX project. -->
  <PropertyGroup>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>true</IncludeCopyLocalReferencesInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <UseCodebase>true</UseCodebase>
  </PropertyGroup>

  <!--
    F5 trap: a hand-written VSIX project has no debug launch settings, so F5 ("run")
    is interpreted as INSTALL the .vsix and the VSIX Installer wizard opens (the
    extension gets installed into the everyday Visual Studio - which is NOT what we
    want). The classic template writes these to .csproj.user; since .user is not
    committed, we keep them in .csproj. Now F5 launches the extension in a separate
    "Exp" hive and the everyday VS stays clean.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <!-- The VSIX manifest: SDK globbing already picks it up as None; here we only set the
       Designer sub-type (Update, not Include, to avoid a duplicate item). -->
  <ItemGroup>
    <None Update="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <!-- The Marketplace / extension icon referenced by the manifest's <Icon>. The VSSDK collects
       Content items flagged IncludeInVSIX into the package root; it adds nothing to the loaded
       assemblies. (None + IncludeInVSIX is not honoured by this build-tools version.) -->
  <ItemGroup>
    <Content Include="icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- The listing screenshot, referenced by the manifest's <PreviewImage>. -->
    <Content Include="preview.jpg">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- The licence and the change log are what the extension manager and the Marketplace listing
       show for <License> and <ReleaseNotes>, so the manifest names them - which means they have to
       be inside the package, not merely in the repository. Linked from the root so there is one
       copy of each and no chance of the shipped text drifting from the committed one. -->
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="..\..\CHANGELOG.md" Link="CHANGELOG.md">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <!-- The command table. ResourceName MUST be "Menus.ctmenu" to match the package's
       [ProvideMenuResource("Menus.ctmenu", 1)]. VSCTCompile compiles the .vsct into the
       embedded .ctmenu resource; SDK globbing would otherwise treat it as plain None. -->
  <ItemGroup>
    <None Remove="VSCommandTable.vsct" />
    <VSCTCompile Include="VSCommandTable.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- The VS-independent bridge core; Bridge.dll is copied into the VSIX (Private=true). -->
  <ItemGroup>
    <ProjectReference Include="..\Nlabs.ClaudeCodeVsPackage.Bridge\Nlabs.ClaudeCodeVsPackage.Bridge.csproj">
      <Name>Nlabs.ClaudeCodeVsPackage.Bridge</Name>
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- MenuCommandService (base of OleMenuCommandService, provides AddCommand) lives in
       System.Design.dll - a framework assembly the SDK does not reference by default. -->
  <ItemGroup>
    <Reference Include="System.Design" />
    <!-- FolderBrowserDialog for the "pick working folder" action. A framework assembly present in
         devenv's runtime, so it is referenced but never bundled into the VSIX. -->
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <!-- Roslyn workspace + symbol search. VS provides these at runtime, so exclude the
         runtime assets (never bundle them) and compile against the API only. -->
    <PackageReference Include="Microsoft.VisualStudio.LanguageServices" Version="4.14.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The package itself lands several folders deep in bin\<Configuration>\net472, which is a poor
    place to hand anyone a build from - and the name there carries no version, so two builds are
    indistinguishable once copied anywhere. This drops a stamped copy at the repository root under
    artifacts\, so "the extension" is one obvious file instead of a path to remember.

    Additive on purpose: the normal build output stays exactly where the VSSDK puts it, nothing is
    moved, and artifacts\ is ignored by git.
  -->
  <!--
    The version lives in two files: this one drives the assembly, the manifest drives what Visual
    Studio installs and compares against what is already there. They are read by different tools, so
    nothing complains when they drift - and the symptom is silent: the installer sees the version it
    already has and keeps the old extension, so a build "does not take" for reasons no error explains.
    Cheaper to fail the build than to debug that.
  -->
  <Target Name="CheckVsixVersionMatches" BeforeTargets="CreateVsixContainer">
    <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)source.extension.vsixmanifest"
             Query="/vsx:PackageManifest/vsx:Metadata/vsx:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='vsx' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" ItemName="ManifestVersion" />
    </XmlPeek>
    <Error Condition="'@(ManifestVersion)' != '' AND '@(ManifestVersion)' != '$(Version)'"
           Text="Version mismatch: the project says $(Version), source.extension.vsixmanifest says @(ManifestVersion). Visual Studio installs the manifest's version, so update both." />
  </Target>

  <Target Name="CopyVsixToArtifacts" AfterTargets="CreateVsixContainer"
          Condition="'$(TargetVsixContainer)' != '' AND Exists('$(TargetVsixContainer)')">
    <PropertyGroup>
      <ArtifactsDir>$(MSBuildThisFileDirectory)..\..\artifacts\</ArtifactsDir>
      <ArtifactVsix>$(ArtifactsDir)$(AssemblyName)-$(Version)-$(Configuration).vsix</ArtifactVsix>
    </PropertyGroup>
    <MakeDir Directories="$(ArtifactsDir)" />
    <Copy SourceFiles="$(TargetVsixContainer)" DestinationFiles="$(ArtifactVsix)" />
    <Message Importance="high" Text="VSIX -&gt; $(ArtifactVsix)" />
  </Target>

</Project>
