<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The core of the bridge. It has ZERO dependency on Visual Studio: the WebSocket
    server, the handshake rules and the token live here. This lets the security logic
    be tested with a plain test project, without opening VS. The VSIX project references
    this assembly and ships Bridge.dll inside the package.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Nlabs.ClaudeCodeVsPackage.Bridge</RootNamespace>
    <AssemblyName>Nlabs.ClaudeCodeVsPackage.Bridge</AssemblyName>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

  <!-- JSON for the MCP protocol layer. Visual Studio ships Newtonsoft.Json (with binding
       redirects), so the runtime assets are excluded here and never bundled in the VSIX;
       the test project supplies the runtime copy. -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
