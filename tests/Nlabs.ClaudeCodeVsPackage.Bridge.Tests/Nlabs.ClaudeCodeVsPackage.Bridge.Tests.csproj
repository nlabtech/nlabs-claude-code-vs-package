<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for the VS-independent bridge core. Targets net472 to match the code under
    test (the bridge ships in an in-process VS extension). No Visual Studio needed:
    the security handshake and job correlation are plain .NET.
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Supplies the Newtonsoft.Json runtime for the bridge (which references it with
         runtime assets excluded, since Visual Studio provides it in the real host). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nlabs.ClaudeCodeVsPackage.Bridge\Nlabs.ClaudeCodeVsPackage.Bridge.csproj" />
  </ItemGroup>

</Project>
