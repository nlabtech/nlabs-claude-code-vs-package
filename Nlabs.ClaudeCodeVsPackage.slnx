<Solution>
  <!-- Without <Deploy />, F5 says "Deploy Not Enabled" and the VSIX is not installed
       into the Experimental Instance (it is only built). This is the .slnx equivalent
       of the classic .sln "...Deploy.0" line; the attribute-less form applies to all
       configurations. If edited by hand, close and reopen the solution. -->
  <Project Path="src/Nlabs.ClaudeCodeVsPackage/Nlabs.ClaudeCodeVsPackage.csproj">
    <Deploy />
  </Project>
  <Project Path="src/Nlabs.ClaudeCodeVsPackage.Bridge/Nlabs.ClaudeCodeVsPackage.Bridge.csproj" />
  <Folder Name="/tests/">
    <Project Path="tests/Nlabs.ClaudeCodeVsPackage.Bridge.Tests/Nlabs.ClaudeCodeVsPackage.Bridge.Tests.csproj" />
  </Folder>
</Solution>
